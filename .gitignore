# ============================================
# 惜物 Xiwu Monorepo .gitignore
# ============================================

# ============ 通用 ============
*.class
*.log
*.pyc
*.pyo
*.swp
*.swo
*~
.DS_Store
.atom/
.buildlog/
.history
.svn/
Thumbs.db

# IDE
*.iml
*.ipr
*.iws
.idea/
.vscode/

# ============ Client (Flutter) ============
# Flutter/Dart/Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
migrate_working_dir/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android studio Navigation editor temp files
.navigation/

# Android
**/android/app/src/main/jniLibs/
**/android/app/src/main/obj/

# Windows
**/windows/**/*.res
**/windows/**/*.lib
**/windows/**/*.exp
**/windows/**/*.ilk
**/windows/**/*.pdb
**/windows/**/*.exe
**/windows/**/*.dll

# macOS
**/macos/Flutter/ephemeral
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Linux
**/linux/flutter/ephemeral/

# Release APK output
output/

# ============ Server (Python/FastAPI) ============
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
eggs/
*.whl

# Virtual environments
.venv/
venv/
ENV/

# Environment variables
Server/.env

# Database
*.db
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# ============ Docker ============
docker-compose.override.yml
